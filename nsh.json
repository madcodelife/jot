{
  "name": "Jot",
  "entry": "app/App.tsx",
  "id": "com.madcodelife.jot",
  "version": "0.1.2",
  "build": 3,
  "icon": {
    "macos": "assets/icon-macos.png"
  },
  "rust": ".",
  "theme": "app/ui/theme.json",
  "window": {
    "title": "Jot",
    "defaultVisible": false,
    "defaultSize": {
      "width": 420,
      "height": 300
    }
  },
  "macos": {
    "activationPolicy": "accessory",
    "infoPlist": {
      "NSMicrophoneUsageDescription": "Jot listens while you hold ⌥ and writes what you say into your notes. 按住 ⌥ 说话时，Jot 用麦克风把你说的话记进笔记。",
      "NSSpeechRecognitionUsageDescription": "Jot turns what you say into text for your notes. Jot 把你说的话转成笔记里的文字。"
    }
  },
  "capabilities": {
    "application": true,
    "notifications": true,
    "windows": {
      "kinds": [
        "normal",
        "popup",
        "overlay"
      ],
      "overlay": true
    },
    "clipboard": true,
    "openUrl": {
      "schemes": [
        "https",
        "x-apple.systempreferences"
      ]
    },
    "speech": true,
    "audio": true
  },
  "updater": {
    "github": "madcodelife/jot",
    "publicKey": "X3S6vy172GDrELktQEraG3MP7djBwOFPKyMqhti5ALY=",
    "packages": {
      "roots": [
        "N1iJSwkFqZmAlmqgjFn7Aqsq45F8othN7jX8oUqkaxY="
      ]
    }
  },
  "dependencies": {
    "nsh-icon": "^0.2.2",
    "nsh-icon-lucide": "^0.2.2"
  }
}
